# =============================================================================
# Enterprise Legal Contract Analyzer - Git Ignore
# =============================================================================

# Environment Variables (NEVER commit secrets!)
.env
.env.local
.env.*.local

# Python Virtual Environment
venv/
.venv/
env/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / Packaging
dist/
build/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS Files
.DS_Store
Thumbs.db

# Logs
*.log

# HuggingFace Cache (can be large)
.cache/
